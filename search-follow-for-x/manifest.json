{
  "manifest_version": 3,
  "name": "Search & Follow for X",
  "short_name": "Search & Follow",
  "version": "1.2.0",
  "description": "Search X for a topic and follow matching accounts from the People results, slowly, with per-run and daily caps.",
  "minimum_chrome_version": "102",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Search & Follow for X",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
